{
  "name": "fairy-maid-brigade",
  "version": "0.1.0",
  "private": true,
  "description": "Fairy Maid Brigade - A cross-PC plugin-based inter-software workflow orchestration platform.",
  "main": "out/main/index.js",
  "bin": {
    "fmb": "out/cli/index.js"
  },
  "author": "Fairy Maid Brigade",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "node scripts/dev-runner.mjs",
    "build:main": "node scripts/build-main.mjs build",
    "build:cli": "node scripts/build-cli.mjs build",
    "build": "pnpm build:main && pnpm build:cli && electron-vite build",
    "build:icons": "node scripts/make-icons.mjs",
    "build:win": "pnpm build:icons && pnpm build && electron-builder --win --x64",
    "test:fi": "node scripts/_build-fi.mjs && node build/fault-injection.mjs",
    "self-check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/self-check.ps1",
    "package:plugins": "node scripts/package-plugin.ts",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.shared.json && tsc --noEmit -p tsconfig.cli.json",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\""
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.1.0",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@hono/node-server": "^2.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "adm-zip": "^0.6.0",
    "antd": "^5.12.0",
    "better-sqlite3": "11.7.0",
    "commander": "^15.0.0",
    "dayjs": "^1.11.10",
    "electron-log": "^5.4.4",
    "eventemitter2": "^6.4.9",
    "hono": "^4.13.5",
    "kysely": "^0.29.5",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.21.0",
    "rotating-file-stream": "^3.2.10",
    "semver": "^7.8.5",
    "sqlite": "^5.1.1",
    "zod": "^3.24.1",
    "zustand": "^4.4.7"
  }
}
